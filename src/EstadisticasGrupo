import java.util.Scanner;

public class EstadisticasGrupo {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

    
        double[] notas = new double[10];


        System.out.println("Ingrese las 10 notas del grupo (ejemplo: 3.5):");
        for (int i = 0; i < 10; i++) {
            System.out.print("Nota " + (i + 1) + ": ");
            notas[i] = scanner.nextDouble();
        }


        double suma = 0;
        double masAlta = notas[0];
        int posAlta = 0;
        double masBaja = notas[0];
        int posBaja = 0;
        int aprobados = 0;
        int reprobados = 0;


        for (int i = 0; i < 10; i++) {
            suma += notas[i];

            if (notas[i] > masAlta) {
                masAlta = notas[i];
                posAlta = i;
            }

            if (notas[i] < masBaja) {
                masBaja = notas[i];
                posBaja = i;
            }

            if (notas[i] >= 3.0) {
                aprobados++;
            } else {
                reprobados++;
            }
        }

        double promedio = suma / 10.0;


        System.out.println("\n--- ESTADÍSTICAS DEL GRUPO ---");
        System.out.printf("Promedio del grupo: %.2f%n", promedio);
        System.out.printf("Nota más alta: %.1f (en la posición %d)%n", masAlta, posAlta);
        System.out.printf("Nota más baja: %.1f (en la posición %d)%n", masBaja, posBaja);
        System.out.println("Aprobados: " + aprobados);
        System.out.println("Reprobados: " + reprobados);

        scanner.close();
    }
}